### Fabric client run artifacts (loom/game output, regenerable) ###
# Anchored to the repo root on purpose. An unanchored "data/" also matched
# common/src/main/resources/data/, which silently dropped a required plugin
# resource (special_types.yml) and made the plugin fail on enable.
/saves/
/logs/
/data/
/downloads/
/.fabric/
/options.txt
/usercache.json

### Loom run directories inside version nodes (rig output, never source) ###
fabric/*/config/
fabric/*/mods/
fabric/*/resourcepacks/
fabric/*/run/
fabric/26.2/crash-reports/
fabric/26.2/saves/
fabric/26.2/run/
