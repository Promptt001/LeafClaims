{
  "schemaVersion": 1,
  "id": "leafclaims",
  "accessWidener": "leafclaims.accessWidener",
  "version": "${version}",
  "name": "LeafClaims",
  "icon": "assets/leafclaims/icon.png",
  "description": "${description}",
  "authors": [
    {
      "name": "William278",
      "contact": {
        "sources": "https://github.com/WiIIiam278/HuskClaims"
      }
    }
  ],
  "contributors": [
    "Promptt001"
  ],
  "license": "Apache-2.0",
  "contact": {
    "homepage": "https://github.com/Promptt001/LeafClaims",
    "sources": "https://github.com/Promptt001/LeafClaims",
    "issues": "https://github.com/Promptt001/LeafClaims/issues"
  },
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.promptt001.leafclaims.FabricLeafClaims"
    ]
